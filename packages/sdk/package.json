{
  "name": "@kern/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KERN browser SDK — page context capture and the customer-facing chat/guidance widget",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kern/contracts": "*"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
