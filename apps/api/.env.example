# Copy this file to .env and fill in values.
# Without ANTHROPIC_API_KEY the API runs in mock mode (canned page-aware replies).

ANTHROPIC_API_KEY=

# Model used by the gateway. The gateway is provider-agnostic; Anthropic is
# the first provider. claude-opus-5 is the default per project policy.
KERN_MODEL=claude-opus-5

PORT=8787
