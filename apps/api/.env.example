# Copy this file to .env and fill in values.
# Without any provider key the API runs in mock mode (canned page-aware replies).

# --- Anthropic (default when present) ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
# Model used when the OpenAI provider is active (override if your account
# uses a different model id)
KERN_OPENAI_MODEL=gpt-4o

# --- Gateway selection ---
# 'anthropic' | 'openai' | unset = auto (Anthropic if key present, else OpenAI, else mock)
KERN_PROVIDER=

# Model used when the Anthropic provider is active
KERN_MODEL=claude-opus-5

# Demo site URL the knowledge crawler indexes (default http://localhost:3000)
# KERN_DEMO_SITE_URL=http://localhost:3000

PORT=8787
